@baseUrl = http://localhost:8080
@user = alice
@otherUser = bob
# Id of an existing recipe — create one with createRecipe in recipes.http
@recipeId = 00000000-0000-0000-0000-000000000000

### ======================================================================================
### Budget
### ======================================================================================

### How much of the caller's MEAL_PLAN budget is already spent
# @name getMealPlanBalance
GET {{baseUrl}}/meal-plans/balance
Authorization: Bearer {{user}}

### ======================================================================================
### Meal plans
### ======================================================================================

### Create a meal plan — run this before any request that uses {{planId}}
# @name createPlan
POST {{baseUrl}}/meal-plans
Authorization: Bearer {{user}}
Content-Type: application/json

{ "name": "Weekly Plan", "color": "#FF5733" }

###
@planId = {{createPlan.response.body.$.id}}

### List meal plans accessible by the user
# @name listPlans
GET {{baseUrl}}/meal-plans
Authorization: Bearer {{user}}

### Rename and recolour the meal plan
# @name updatePlan
PUT {{baseUrl}}/meal-plans/{{planId}}
Authorization: Bearer {{user}}
Content-Type: application/json

{ "name": "Updated Plan", "color": "#00FF00" }

### Delete the meal plan and all its entries
# @name deletePlan
DELETE {{baseUrl}}/meal-plans/{{planId}}
Authorization: Bearer {{user}}

### ======================================================================================
### Entries
### ======================================================================================

### Add a recipe-backed entry for today — needs {{recipeId}} set above
# @name createRecipeEntry
POST {{baseUrl}}/meal-plans/{{planId}}/entries
Authorization: Bearer {{user}}
Content-Type: application/json

{ "date": "{{$localDatetime "YYYY-MM-DD"}}", "recipeId": "{{recipeId}}", "servingSize": 4 }

###
@recipeEntryId = {{createRecipeEntry.response.body.$.id}}

### Add a placeholder entry for today
# @name createPlaceholderEntry
POST {{baseUrl}}/meal-plans/{{planId}}/entries
Authorization: Bearer {{user}}
Content-Type: application/json

{ "date": "{{$localDatetime "YYYY-MM-DD"}}", "placeholderText": "Lunch with friends" }

###
@placeholderEntryId = {{createPlaceholderEntry.response.body.$.id}}

### Update the recipe-backed entry's serving size
# @name updateRecipeEntry
PUT {{baseUrl}}/meal-plans/{{planId}}/entries/{{recipeEntryId}}
Authorization: Bearer {{user}}
Content-Type: application/json

{ "date": "{{$localDatetime "YYYY-MM-DD"}}", "recipeId": "{{recipeId}}", "servingSize": 6, "planId": "{{planId}}" }

### Delete the recipe-backed entry
# @name deleteRecipeEntry
DELETE {{baseUrl}}/meal-plans/{{planId}}/entries/{{recipeEntryId}}
Authorization: Bearer {{user}}

### Delete the placeholder entry
# @name deletePlaceholderEntry
DELETE {{baseUrl}}/meal-plans/{{planId}}/entries/{{placeholderEntryId}}
Authorization: Bearer {{user}}

### ======================================================================================
### Calendar and shopping list generation
### ======================================================================================

### Calendar view for the next 30 days
# @name getCalendar
GET {{baseUrl}}/meal-plans/calendar?startDate={{$localDatetime "YYYY-MM-DD"}}&endDate={{$localDatetime "YYYY-MM-DD" 30 d}}&planIds={{planId}}
Authorization: Bearer {{user}}

### Generate shopping list items from today's planned meals
# @name generateShoppingList
POST {{baseUrl}}/meal-plans/generate-shopping-list
Authorization: Bearer {{user}}
Content-Type: application/json

{ "planIds": ["{{planId}}"], "selectedDates": ["{{$localDatetime "YYYY-MM-DD"}}"] }

### ======================================================================================
### Sharing
### ======================================================================================

### List the meal plan's permissions
# @name listPlanPermissions
GET {{baseUrl}}/meal-plans/{{planId}}/permissions
Authorization: Bearer {{user}}

### Share it with bob — creates a pending invite; answer it from invites.http as bob
# @name sharePlan
POST {{baseUrl}}/meal-plans/{{planId}}/share
Authorization: Bearer {{user}}
Content-Type: application/json

{ "email": "{{otherUser}}@local.test", "role": "EDITOR" }

### Unshare it from bob
# @name unsharePlan
POST {{baseUrl}}/meal-plans/{{planId}}/unshare
Authorization: Bearer {{user}}
Content-Type: application/json

{ "email": "{{otherUser}}@local.test" }
