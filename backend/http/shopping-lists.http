@baseUrl = http://localhost:8080
@user = alice
@otherUser = bob

### ======================================================================================
### Budget and limits
### ======================================================================================

### How much of the caller's SHOPPING_LIST budget is already spent
# @name getShoppingListBalance
GET {{baseUrl}}/shopping-lists/balance
Authorization: Bearer {{user}}

### The SHOPPING_LIST_ITEM quota that applies to this list
# @name getShoppingListItemLimit
GET {{baseUrl}}/shopping-lists/{{listId}}/limits
Authorization: Bearer {{user}}

### ======================================================================================
### Shopping lists
### ======================================================================================

### Create a shopping list — run this before any request that uses {{listId}}
# @name createList
POST {{baseUrl}}/shopping-lists
Authorization: Bearer {{user}}
Content-Type: application/json

{ "name": "Weekly Groceries" }

###
@listId = {{createList.response.body.$.id}}

### List shopping lists accessible by the user
# @name listLists
GET {{baseUrl}}/shopping-lists
Authorization: Bearer {{user}}

### Get the list — shows each item's position and version
# @name getList
GET {{baseUrl}}/shopping-lists/{{listId}}
Authorization: Bearer {{user}}

### Rename the list
# @name renameList
PUT {{baseUrl}}/shopping-lists/{{listId}}
Authorization: Bearer {{user}}
Content-Type: application/json

{ "name": "Monthly Groceries" }

### Delete the shopping list and all its items
# @name deleteList
DELETE {{baseUrl}}/shopping-lists/{{listId}}
Authorization: Bearer {{user}}

### ======================================================================================
### Items
### ======================================================================================

### Add an item — position is client-supplied, creates never conflict
# @name addItem
POST {{baseUrl}}/shopping-lists/{{listId}}/items
Authorization: Bearer {{user}}
Content-Type: application/json

{ "name": "Milk", "quantity": 2.0, "unit": "liters", "position": 1.0 }

###
@itemId = {{addItem.response.body.$.id}}

### Update the item — version-gated: baseVersion must match the stored item
# @name updateItem
PUT {{baseUrl}}/shopping-lists/{{listId}}/items/{{itemId}}
Authorization: Bearer {{user}}
Content-Type: application/json

{ "baseVersion": 0, "name": "Whole Milk", "quantity": 2.0, "unit": "liters", "checked": false, "position": 1.0 }

### Delete the item
# @name deleteItem
DELETE {{baseUrl}}/shopping-lists/{{listId}}/items/{{itemId}}?baseVersion=1
Authorization: Bearer {{user}}

### ======================================================================================
### Sharing
### ======================================================================================

### List the list's permissions
# @name listListPermissions
GET {{baseUrl}}/shopping-lists/{{listId}}/permissions
Authorization: Bearer {{user}}

### Share it with bob — creates a pending invite
# @name shareList
POST {{baseUrl}}/shopping-lists/{{listId}}/share
Authorization: Bearer {{user}}
Content-Type: application/json

{ "email": "{{otherUser}}@local.test", "role": "EDITOR" }

### The list as bob — unreadable while the invite is pending, readable once he accepts it
# @name getListAsOtherUser
GET {{baseUrl}}/shopping-lists/{{listId}}
Authorization: Bearer {{otherUser}}

### Unshare bob — revokes his permission if he accepted, or cancels the pending invite if he hasn't
# @name unshareList
POST {{baseUrl}}/shopping-lists/{{listId}}/unshare
Authorization: Bearer {{user}}
Content-Type: application/json

{ "email": "{{otherUser}}@local.test" }
