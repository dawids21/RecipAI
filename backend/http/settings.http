@baseUrl = http://localhost:8080
@user = alice1
@admin = admin

### Delete the caller's account — DESTRUCTIVE: permanently removes every recipe, collection,
### shopping list, meal plan, permission, invite and usage row belonging to {{user}}
# @name deleteOwnAccount
DELETE {{baseUrl}}/settings/account
Authorization: Bearer {{user}}

### Delete any account by email — DESTRUCTIVE: permanently removes every recipe, collection,
### shopping list, meal plan, permission, invite and usage row belonging to {{user}}@local.test
# @name deleteAccountAsAdmin
DELETE {{baseUrl}}/admin/accounts?email={{user}}@local.test
Authorization: Bearer {{admin}}
