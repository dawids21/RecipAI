@baseUrl = http://localhost:8080
@user = alice

### ======================================================================================
### Budget
### ======================================================================================

### How much of the caller's EXTRACTION budget is already spent
# @name getExtractionBalance
GET {{baseUrl}}/extract/balance
Authorization: Bearer {{user}}

### ======================================================================================
### Extraction
### ======================================================================================

### Extract a recipe from text
# @name extractFromText
POST {{baseUrl}}/extract/text
Authorization: Bearer {{user}}
Content-Type: application/json

{ "text": "Pizza: 300g flour, 200ml tomato sauce, salt to taste. Make dough, then add sauce and toppings." }

### Extract a recipe from an image
# @name extractFromImage
POST {{baseUrl}}/extract/image
Authorization: Bearer {{user}}
Content-Type: multipart/form-data; boundary=RecipAIBoundary

--RecipAIBoundary
Content-Disposition: form-data; name="file"; filename="recipe.jpg"
Content-Type: image/jpeg

< ./fixtures/e36c65a2-062b-48ac-bdc9-ebffb59ecc07.jpg
--RecipAIBoundary--
