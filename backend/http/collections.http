@baseUrl = http://localhost:8080
@user = alice
@otherUser = bob

### ======================================================================================
### Budget
### ======================================================================================

### How much of the caller's RECIPES_COLLECTION budget is already spent
# @name getCollectionBalance
GET {{baseUrl}}/collections/balance
Authorization: Bearer {{user}}

### ======================================================================================
### Collections
### ======================================================================================

### Create a collection — run this before any request that uses {{collectionId}}
# @name createCollection
POST {{baseUrl}}/collections
Authorization: Bearer {{user}}
Content-Type: application/json

{ "name": "Italian Recipes" }

###
@collectionId = {{createCollection.response.body.$.id}}

### List collections accessible by the user
# @name listCollections
GET {{baseUrl}}/collections
Authorization: Bearer {{user}}

### Rename the collection
# @name renameCollection
PUT {{baseUrl}}/collections/{{collectionId}}
Authorization: Bearer {{user}}
Content-Type: application/json

{ "name": "European Recipes" }

### Delete the collection
# @name deleteCollection
DELETE {{baseUrl}}/collections/{{collectionId}}
Authorization: Bearer {{user}}

### ======================================================================================
### Sharing
### ======================================================================================

### List the collection's permissions
# @name listCollectionPermissions
GET {{baseUrl}}/collections/{{collectionId}}/permissions
Authorization: Bearer {{user}}

### Share it with bob — creates a pending invite; answer it from invites.http as bob
# @name shareCollection
POST {{baseUrl}}/collections/{{collectionId}}/share
Authorization: Bearer {{user}}
Content-Type: application/json

{ "email": "{{otherUser}}@local.test", "role": "EDITOR" }

### Unshare it from bob
# @name unshareCollection
POST {{baseUrl}}/collections/{{collectionId}}/unshare
Authorization: Bearer {{user}}
Content-Type: application/json

{ "email": "{{otherUser}}@local.test" }
